# LLM / DashScope
MODEL_NAME=deepseek-v4-pro
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Data source for prepare_stock_data.py
TUSHARE_TOKEN=

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Optional local paths. Leave empty to use project defaults.
DB_PATH=
SCHEMA_DB_PATH=
IMAGE_DIR=
CHROMA_PERSIST_DIR=

# Query behavior
MAX_RETRY=3
MAX_CONTEXT_ROUNDS=5
QUERY_CACHE_TTL=600
MAX_RESULT_ROWS=5000
QUERY_TIMEOUT_SECONDS=60

# Pydantic parses list values from JSON.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8503"]
